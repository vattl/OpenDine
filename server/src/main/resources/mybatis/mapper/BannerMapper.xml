<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace必须与Mapper接口的全限定名完全一致 -->
<mapper namespace="com.lanf.mapper.BannerMapper">

    <!-- id必须与接口中的方法名完全一致 -->
    <select id="selectEnabledBanners" resultType="com.lanf.entity.Banner">
        SELECT * FROM t_banner where status=1 ORDER BY id ASC
    </select>

    <select id="selectAllBanners" resultType="com.lanf.entity.Banner">
        SELECT * FROM t_banner ORDER BY id ASC
    </select>

</mapper>
