<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lanf.mapper.CouponMapper">

    <resultMap type="com.lanf.entity.Coupon" id="CategoryResult">

    </resultMap>

    <select id="selectAvailableCoupons" parameterType="Map" resultMap="CategoryResult">
        select * from t_coupon WHERE status = 1;

    </select>
    <select id="selectValidCouponById" parameterType="Map" resultMap="CategoryResult">
        select * from t_coupon
        <where>
            <if test="id!=null and id!=''">
                and id = #{id}
            </if>
        </where>

    </select>


</mapper>
