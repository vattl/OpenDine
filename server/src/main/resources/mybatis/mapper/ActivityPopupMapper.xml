<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace必须与Mapper接口的全限定名完全一致 -->
<mapper namespace="com.lanf.mapper.ActivityPopupMapper">

    <!-- id必须与接口中的方法名完全一致 -->
    <select id="selectEnabledPopup" resultType="com.lanf.entity.ActivityPopup">
        SELECT * FROM t_activity_popup where is_enabled=1 ORDER BY id ASC
    </select>

    <select id="selectAllPopup" resultType="com.lanf.entity.ActivityPopup">
        SELECT * FROM t_activity_popup ORDER BY id ASC
    </select>

</mapper>
