{
  "description": "与 docs/openapi.yaml 中 C 端（小程序/顾客）接口对齐的 AI function calling 工具列表；名称采用 snake_case，description 标注对应 OpenAPI path",
  "field_description_reference": {
    "openid": "用户微信唯一标识",
    "order_no": "业务订单号（系统内订单主键号）",
    "orderNo": "业务订单号（部分支付接口使用驼峰字段）",
    "table_number": "桌号（如 21/A21）",
    "number": "桌号查询参数（兼容字段）",
    "number_of_diners": "就餐人数",
    "cid": "菜品分类编码（业务约定）",
    "name": "菜品名称",
    "quantity": "数量（字符串数字也可）",
    "unit": "单位（串/份/杯等）",
    "total_price": "该行菜品总价",
    "sett_amount": "订单商品原价（含打包费，不含服务费）",
    "discount_amount": "订单优惠金额",
    "coupon_id": "优惠券ID",
    "remark": "备注",
    "status": "状态筛选字段（如订单/优惠券状态）"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "generateOrderNo",
        "description": "内部：生成新订单号（建议 create_order 前调用；无对应独立 HTTP path）",
        "parameters": { "type": "object", "properties": {} }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_openid",
        "description": "POST /order/getOpenid：用 wx.login 的 code 换取 openid",
        "parameters": {
          "type": "object",
          "properties": { "code": { "type": "string", "description": "微信 jscode2session 的 code" } },
          "required": ["code"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_user_info",
        "description": "POST /order/getUserInfo：按 openid 取用户信息与可用券数量",
        "parameters": {
          "type": "object",
          "properties": { "openid": { "type": "string", "description": "用户微信唯一标识 openid" } },
          "required": ["openid"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "update_user",
        "description": "POST /order/updateUser：更新昵称/手机/生日（生日仅首次可设）",
        "parameters": {
          "type": "object",
          "properties": {
            "openid": { "type": "string", "description": "用户微信唯一标识 openid" },
            "name": { "type": "string", "description": "用户昵称" },
            "phone": { "type": "string", "description": "用户手机号" },
            "birthday": { "type": "string", "description": "yyyy-MM-dd，仅首次可写" }
          },
          "required": ["openid"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_official_phone_number",
        "description": "POST /order/getOfficialPhoneNumber：微信 getPhoneNumber 的 code 换手机号并更新用户",
        "parameters": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "description": "微信 getPhoneNumber 的 code" },
            "openid": { "type": "string", "description": "用户微信唯一标识 openid" },
            "invite_code": { "type": "string", "description": "邀请码（可选）" }
          },
          "required": ["code"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "table_verify",
        "description": "GET /order/table_verify：校验桌号是否存在",
