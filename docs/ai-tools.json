          "type": "object",
          "properties": { "number": { "type": "string", "description": "桌号（如 21/A21）" } },
          "required": ["number"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_table_status",
        "description": "GET /order/table_status：查询桌台占用/状态",
        "parameters": {
          "type": "object",
          "properties": {
            "number": { "type": "string", "description": "推荐字段，桌号" },
            "table_number": { "type": "string", "description": "兼容字段，桌号" },
            "tableNumber": { "type": "string", "description": "兼容字段，桌号" }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_business",
        "description": "POST /order/Business：营业状态与接单开关",
        "parameters": { "type": "object", "properties": {} }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calculate_finish_time",
        "description": "POST /order/calculateFinishTime：预估出餐时间",
        "parameters": {
          "type": "object",
          "properties": { "dineInOrTakeOut": { "type": "string", "description": "堂食或打包" } }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "list_dishes",
        "description": "与 GET /dish/listAll 一致的在售菜单（缓存）：仅 onsale=true；无在售菜的分类不出现",
        "parameters": { "type": "object", "properties": {} }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "list_all_dishes",
        "description": "GET /dish/listAll：仅含至少一道上架菜的分类；dishList 仅 onsale=true",
        "parameters": { "type": "object", "properties": {} }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "create_order",
        "description": "POST /order/create：用户确认下单时调用。必须收集完整菜品、数量、桌号后再调用。",
        "parameters": {
          "type": "object",
          "properties": {
            "openid": { "type": "string","description": "用户openid" },
            "dineInOrTakeOut": { "type": "string", "enum": ["堂食", "打包"], "description": "就餐方式：堂食或打包" },
            "number_of_diners": { "type": "string","description": "就餐人数" },
            "table_number": { "type": "string","description": "桌号" },
            "order_no": { "type": "string","description": "订单号" },
            "sett_amount": { "type": "number","description": "商品原价+打包费" },
            "discount_amount": { "type": "number","description": "优惠金额" },
            "coupon_id": { "type": "integer","description": "优惠券ID" },
            "remark": { "type": "string","description": "订单备注" },
            "goods_list": {
              "type": "array",
              "description": "订单明细，对应表 t_order_detail；下列带「服务端写入」的字段新建下单勿传",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "integer", "description": "明细主键 t_order_detail.id，自增；新建勿传" },
                  "mId": { "type": "integer", "description": "订单主表ID t_order_detail.mId；服务端保存主单后写入，新建勿传" },
                  "name": { "type": "string", "description": "菜品名称 t_order_detail.name" },
                  "quantity": { "type": "string", "description": "数量 t_order_detail.quantity" },
                  "unit": { "type": "string", "description": "单位 t_order_detail.unit，如 串/份/杯" },
                  "image": { "type": "string", "description": "菜品图片URL t_order_detail.image，可选" },
                  "total_price": { "type": "number", "description": "该行总价 t_order_detail.total_price" },
                  "Morder_no": { "type": "string", "description": "订单号 t_order_detail.Morder_no；服务端写入，新建勿传" },
                  "Morder_num": { "type": "integer", "description": "下单批次 t_order_detail.Morder_num；服务端写入，新建勿传" },
                  "order_rece": { "type": "string", "description": "接单状态 t_order_detail.order_rece，如 mis_order/rec_order；服务端写入，新建勿传" },
                  "remark": { "type": "string", "description": "行备注 t_order_detail.remark" },
                  "selectedSpicy": { "type": "string", "description": "口味/规格等 JSON 字符串 t_order_detail.selectedSpicy，如 {\"辣度\":\"微辣\"}" },
                  "cid": { "type": "string", "description": "分类/业务侧菜品标识 t_order_detail.cid" }
                },
                "required": ["name", "quantity", "total_price", "cid"]
              }
            }
          },
          "required": ["openid", "dineInOrTakeOut", "number_of_diners", "goods_list", "table_number"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "add_dishes",
        "description": "POST /order/addDishes：已有订单加菜",
        "parameters": {
          "type": "object",
          "properties": {
            "order_no": { "type": "string", "description": "主订单号" },
            "table_number": { "type": "string", "description": "桌号" },
            "sett_amount": { "type": "number", "description": "加菜后订单原价（不含服务费）" },
            "remark": { "type": "string", "description": "加菜备注（可选）" },
            "goods_list": {
              "type": "array",
              "description": "加菜明细，对应表 t_order_detail；带「服务端写入」的字段加菜请求勿传",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "integer", "description": "明细主键 t_order_detail.id；加菜新建行勿传" },
                  "mId": { "type": "integer", "description": "订单主表ID t_order_detail.mId；加菜时服务端写入，勿传" },
                  "name": { "type": "string", "description": "菜品名称 t_order_detail.name" },
                  "quantity": { "type": "string", "description": "数量 t_order_detail.quantity" },
                  "unit": { "type": "string", "description": "单位 t_order_detail.unit" },
                  "image": { "type": "string", "description": "菜品图片 t_order_detail.image，可选" },
                  "total_price": { "type": "number", "description": "该行总价 t_order_detail.total_price" },
                  "Morder_no": { "type": "string", "description": "订单号 t_order_detail.Morder_no；服务端写入，勿传" },
                  "Morder_num": { "type": "integer", "description": "下单批次 t_order_detail.Morder_num；服务端写入，勿传" },
                  "order_rece": { "type": "string", "description": "接单状态 t_order_detail.order_rece；服务端写入，勿传" },
                  "remark": { "type": "string", "description": "行备注 t_order_detail.remark" },
                  "selectedSpicy": { "type": "string", "description": "口味JSON字符串 t_order_detail.selectedSpicy" },
                  "cid": { "type": "string", "description": "分类/业务标识 t_order_detail.cid" }
                },
                "required": ["name", "quantity", "total_price", "cid"]
              }
            }
          },
          "required": ["order_no", "table_number", "goods_list"]
        }
      }
    },
