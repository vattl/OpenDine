# Copy to .env. Values are intentionally empty: NO usable default secrets.
# Generate a different random value for every secret (see deployment guide).
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
AUTH_JWT_CURRENT_SECRET=
APPROVAL_TOKEN_ENVELOPE_KEY=
PAYMENT_CONFIG_MASTER_KEY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SHOP_NAME=

# Local verification; use https://your-domain for a real installation.
APP_PUBLIC_BASE_URL=http://localhost:8080
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Optional third-party services. Empty values leave integrations unconfigured.
WEIXIN_APPID=
WEIXIN_SECRET=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat
AMAP_WEB_KEY=
ZSQ_USERNAME=
ZSQ_PASSWORD=
ZSQ_AUTO_API_ENABLED=false
ZSQ_TAKEOUT_SYNC_ENABLED=false
PERSONAL_COLLECT_WEBHOOK_SECRET=
